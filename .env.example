# Your permanent Shopify domain, without a path (not your custom website domain).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-10

# Public Storefront API token, used only by our server-side GraphQL client.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Existing NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN is supported as a fallback.
# The separate SHOPIFY_ADMIN_ACCESS_TOKEN is not used by Storefront API requests.

# Server-only Google Geocoding key and delivery radius (straight-line kilometers).
GOOGLE_MAPS_API_KEY=
DELIVERY_ORIGIN_ADDRESS=
DELIVERY_RADIUS_KM=

# Optional exact delivery towns, comma-separated; takes precedence over a radius.
DELIVERY_LOCALITIES=

# Public canonical website origin (set to the final deployed domain).
SITE_URL=https://pluqr.nl
SITE_INDEXABLE=true

# Confirmed customer-facing delivery information (leave blank until approved).
DELIVERY_DAYS=
DELIVERY_FEE_TEXT=
NEW_YEAR_ORDER_DEADLINE=
